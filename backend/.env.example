# ---- Database (Neon PostgreSQL) -------------------------------------------
# Runtime connection. On Neon use the POOLED host (it contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct (non-pooled) connection, used only by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15"

# ---- Auth -------------------------------------------------------------------
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string-of-at-least-32-characters"
JWT_EXPIRES_IN_SECONDS=604800
COOKIE_SAME_SITE=lax

# ---- Networking ---------------------------------------------------------------
PORT=4000
# Browser origin(s) allowed to call this API. Comma-separate to allow several.
FRONTEND_URL="http://localhost:3000"
# Number of reverse proxies in front of the API (see DEPLOYMENT_GUIDE.md).
TRUST_PROXY_HOPS=1

# ---- Tests (only needed for integration tests) ------------------------------
# A throwaway database. NEVER point this at data you care about: tests wipe it.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/memed_test"
